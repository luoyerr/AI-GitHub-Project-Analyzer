# AI Provider Configuration - Qwen Free API
AI_PROVIDER=your-provider
AI_MODEL=your-model
AI_API_KEY=your-api-key
AI_BASE_URL=your-base-url

# Agent Settings
AGENT_TIMEOUT=180
AGENT_MAX_RETRIES=2
AGENT_PARALLEL_LIMIT=4

# Logging
LOG_LEVEL=INFO

# Analysis Settings
MAX_REPO_SIZE_MB=100
INCLUDE_TESTS=true
ANALYSIS_DEPTH=10

# Repository Cache Settings
# 仓库缓存模式：keep（永久保留）/ delete（分析后删除）/ reuse（存在则复用，推荐）/ ask（运行时询问）
REPO_CLEANUP_MODE=reuse
